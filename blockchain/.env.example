# PaymentKuy Blockchain — Environment Variables
# Copy this file to .env and fill in real values for Sepolia deployment.
# DO NOT commit .env to git!

# ─── Sepolia Testnet ──────────────────────────────────────────────────────────
# Your wallet private key (from MetaMask → Account Details → Export Private Key)
# Must have Sepolia ETH (get free from: https://sepoliafaucet.com)
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_here

# Sepolia RPC URL — use Alchemy or Infura (free tier is fine)
# Alchemy:  https://dashboard.alchemy.com
# Infura:   https://app.infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ─── Etherscan (for contract verification) ───────────────────────────────────
# Get free API key from: https://etherscan.io/register
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ─── Gas Reporter ────────────────────────────────────────────────────────────
REPORT_GAS=false
